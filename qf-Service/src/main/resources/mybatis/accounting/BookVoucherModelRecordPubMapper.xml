<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qifu.accounting.voucher.mapper.BookVoucherModelRecordPubMapper">

    <resultMap type="BookVoucherModelRecordPub" id="BookVoucherModelRecordPubResult">
        <result property="id"    column="id"    />
        <result property="pubId"    column="pub_id"    />
        <result property="summary"    column="summary"    />
        <result property="subjectCode"    column="subject_code"    />
        <result property="balanceDirection"    column="balance_direction"    />
        <result property="balanceDirectionText"    column="balance_direction_text"    />
    </resultMap>

    <select id="selectListByPubId" resultType="BookVoucherModelRecordPub">
        SELECT * from book_voucher_model_record_pub where pub_id = #{pubId}
    </select>


</mapper>
