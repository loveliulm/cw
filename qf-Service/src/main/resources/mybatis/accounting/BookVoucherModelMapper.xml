<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qifu.accounting.voucher.mapper.BookVoucherModelMapper">

    <resultMap type="BookVoucherModel" id="BookVoucherModelResult">
        <result property="modelId"    column="model_id"    />
        <result property="bookId"    column="book_id"    />
        <result property="attachmentCount"    column="attachment_count"    />
        <result property="isAmount"    column="is_amount"    />
        <result property="name"    column="name"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <select id="selectModelWageVpById" resultType="BookVoucherModelWageVo">
        select  * from book_voucher_model where model_id = #{modelId}
    </select>


    <select id="getVoucherModelByWage" resultType="BookVoucherModel">
        select  * from book_voucher_model where book_id = #{bookId} and type = #{typeEnum}
    </select>


</mapper>
