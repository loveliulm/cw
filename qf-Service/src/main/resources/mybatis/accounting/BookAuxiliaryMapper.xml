<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qifu.accounting.sys.mapper.BookAuxiliaryMapper">

    <resultMap type="BookAuxiliary" id="BookAuxiliaryResult">
        <result property="auxiliaryId"    column="auxiliary_id"    />
        <result property="bookId"    column="book_id"    />
        <result property="code"    column="code"    />
        <result property="name"    column="name"    />
        <result property="phoneNumber"    column="phone_number"    />
        <result property="address"    column="address"    />
        <result property="remark"    column="remark"    />
        <result property="auxiliaryTypeId"    column="auxiliary_type_id"    />
        <result property="auxiliaryType"    column="auxiliary_type"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createTime"    column="create_time"    />
        <result property="createUserId"    column="create_user_id"    />
    </resultMap>

    <select id="getAuxiliary" resultType="BookAuxiliaryVo">
        SELECT ba.auxiliary_id,ba.name,bat.auxiliary_type,bat.auxiliary_type_text from book_auxiliary ba
        LEFT JOIN book_auxiliary_type bat ON ba.auxiliary_type_id = bat.auxiliary_type_id
        where ba.auxiliary_id = #{auxiliaryId}
    </select>


</mapper>
