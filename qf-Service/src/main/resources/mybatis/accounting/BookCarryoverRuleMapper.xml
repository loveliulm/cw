<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qifu.accounting.carryover.mapper.BookCarryoverRuleMapper">

    <insert id="insertInitCarryOverRule">
        INSERT INTO book_carryover_rule(carryover_id,book_id,code,summary,direction,direction_text,subject_code,subject,origin_subject_code,origin_subject,date_rule,percentage,create_time,update_time)
        values
        <foreach collection="list" item="item" separator=",">
            (
            #{carryover.carryoverId},
            #{carryover.bookId},
            #{item.code},
            #{item.summary},
            #{item.direction},
            #{item.directionText},
            #{item.subjectCode},
            #{item.subject},
            #{item.originSubjectCode},
            #{item.originSubject},
            #{item.dateRule},
            #{item.percentage},
            NOW(),
            NOW()
            )
        </foreach>
    </insert>


    <select id="getListByCarryoverId" resultType="BookCarryoverRule">
        SELECT * FROM `book_carryover_rule` where carryover_id = #{carryoverId} and del_flag = '0';
    </select>


    <select id="getLastCarryoverByAutoBalance" resultType="BookCarryoverRule">
        SELECT * FROM `book_carryover_rule` where carryover_id = #{carryoverId} and del_flag = '0' and date_rule = '自动平衡' limit 0,1;
    </select>

    <update id="deleteByCarryoverId">
        update book_carryover_rule set del_flag = '2' where carryover_id = #{carryoverId}
    </update>


    <update id="resetSalesCostPercentage">
        update book_carryover_rule set percentage = #{percentage} where carryover_id = #{carryoverId}
    </update>

</mapper>
