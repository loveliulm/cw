<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qifu.accounting.report.mapper.BookReportCashRuleMapper">

    <resultMap type="BookReportCashRule" id="BookReportCashRuleResult">
        <result property="id"    column="id"    />
        <result property="subjectCode"    column="subject_code"    />
        <result property="subject"    column="subject"    />
        <result property="sign"    column="sign"    />
        <result property="dataRule"    column="data_rule"    />
        <result property="cashId"    column="cash_id"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <insert id="initInsetReportCashRule">
        INSERT INTO book_report_cash_rule (`subject_code`, `subject`, `sign`, `data_rule`, `cash_id`,create_time,update_time)
        values
        <foreach collection="CashRuleModels" item="item" separator=",">
            ( #{item.subjectCode}, #{item.subject}, #{item.sign},#{item.dataRule},#{cashId},NOW(),NOW())
        </foreach>
    </insert>


    <select id="getList" resultType="BookReportCashRule">
        SELECT * from book_report_cash_rule where cash_id = #{cashId} and del_flag = '0'
    </select>

    <update id="deleteCashRule">
        update book_report_cash_rule set del_flag = '2' where cash_id = #{cashId} and del_flag = '0'
    </update>



</mapper>
