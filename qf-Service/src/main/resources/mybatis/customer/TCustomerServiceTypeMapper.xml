<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qifu.project.customer.mapper.TCustomerServiceTypeMapper">

    <resultMap type="TCustomerServiceType" id="TCustomerServiceTypeResult">
        <result property="customerId"    column="customer_id"    />
        <result property="serviceTypeId"    column="service_type_id"    />
        <result property="serviceTypeName"    column="service_type_name"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <select id="getListByCustomerId" resultType="TCustomerServiceType">
        SELECT * FROM `t_customer_service_type` where customer_id = #{customerId};
    </select>

    <delete id="removeByCustomerId">
        DELETE FROM `t_customer_service_type` where customer_id = #{customerId};
    </delete>


</mapper>
