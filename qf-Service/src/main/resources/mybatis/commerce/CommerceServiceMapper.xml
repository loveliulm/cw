    <update id="deleteBycontractIds" parameterType="Long">
        UPDATE t_commerce_service SET is_del=2 WHERE contract_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectById" parameterType="Long" resultMap="CommerceServiceVoResult">
        select
            cs.*,
            (select user_name from sys_user u where u.user_id = cs.operator_user_id) as operatorUserName,
            ct.customer_name AS customer_name,c.contract_start_date,c.contract_end_date,
            (SELECT service_item_name from base_service_item where service_item_id = c.service_item_id) service_item_name,
            (SELECT service_type_name from base_service_type where service_type_id = c.service_type_id) service_type_name,
            ct.representative ,ct.normal_contact_phone as normalContactPhone
        from t_commerce_service cs
            LEFT JOIN t_contract c ON cs.contract_id = c.contract_id
            LEFT JOIN t_customer ct ON ct.id = c.customer_id
        WHERE
            cs.id = #{id}
    </select>

    <select id="getListByIds" parameterType="Long" resultMap="CommerceServiceResult">
        select <include refid="baseSql"/> from t_commerce_service WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

