        <!--            </if>-->

        <!--        </where>-->
        SELECT
        COUNT( cs.id ) amount,
        SUM( CASE WHEN cs.`status` != 2 THEN 1 ELSE 0 END ) unfinished,
        SUM( CASE WHEN col.is_end = 0 THEN 1 ELSE 0 END ) uncleared
        FROM
        t_commerce_service cs
        LEFT JOIN t_contract c ON cs.contract_id = c.contract_id
        LEFT JOIN t_collection col ON col.contract_id = c.contract_id
        WHERE
        cs.is_del = 0
        <if test="deptId != null and deptId != ''">
            AND c.dept_id = #{deptId}
        </if>
        <if test="type != null and type == 'month' ">
            AND DATE_FORMAT( cs.create_time, '%Y%m' ) = DATE_FORMAT( CURDATE( ), '%Y%m' )
        </if>

    </select>
